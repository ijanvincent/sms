# Production environment for the deployment VM.
# Copy to `.env` on the server and fill in real values. NEVER commit the real .env.

# --- PostgreSQL (the bundled `db` service) ---
POSTGRES_USER=sms
POSTGRES_PASSWORD=__change_me__strong_random__
POSTGRES_DB=sms

# Container-to-container connection string (reaches the `db` service by name).
# The password here MUST match POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://sms:__change_me__strong_random__@db:5432/sms?schema=public

# --- Dashboard auth ---
# Generate the secret:  openssl rand -hex 32
AUTH_SECRET=__change_me__64_hex_chars__
# Generate username + hash:  npm run admin:create -- "admin" "<strong-password>"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=__paste_scrypt_hash_from_admin_create__

# --- Image tags (set automatically by CI) ---
# Leave unset to build images locally on the VM. The GitHub Actions pipeline sets
# these to per-commit (SHA) tags so each deploy is immutable and roll-back-able.
# WEB_IMAGE=sms-web:<sha>
# MIGRATE_IMAGE=sms-migrate:<sha>

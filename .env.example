# Copy to `.env` and adjust. Never commit the real `.env`.

# PostgreSQL credentials — consumed by docker-compose to provision the db service.
POSTGRES_USER=sms
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sms

# App connection string (host-facing). For local dev against the Postgres container.
# The Dockerized `web` service overrides this to target the `db` service host.
DATABASE_URL="postgresql://sms:change_me@localhost:5432/sms?schema=public"

# Dashboard auth (single admin). AUTH_SECRET signs the session JWT — generate a
# long random value, e.g. `openssl rand -hex 32`. The admin credential is created
# with `npm run admin:create -- "<username>" "<password>"`, which prints the two
# lines below; the plaintext password is never stored.
AUTH_SECRET=change_me_to_a_long_random_value
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=run_npm_run_admin_create_to_generate
